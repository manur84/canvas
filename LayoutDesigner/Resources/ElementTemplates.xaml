<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:LayoutDesigner.Models">

    <!--
        Element DataTemplates for Canvas
        Best Practice: Separate DataTemplates into ResourceDictionary for better organization
        Each template is optimized for performance and visual quality
    -->

    <!-- TextElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:TextElement}">
        <!-- Best Practice: Explicit Mode=OneWay for read-only bindings to improve performance -->
        <Border Background="{Binding BackgroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                CornerRadius="{Binding CornerRadius, Mode=OneWay}"
                Padding="{Binding Padding, Mode=OneWay}">
            <!-- Border style - only show border if HasBorder is true -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Style.Triggers>
                        <!-- Show border when HasBorder is true -->
                        <DataTrigger Binding="{Binding HasBorder, Mode=OneWay}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding BorderColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, Mode=OneWay}"/>
                        </DataTrigger>
                        <!-- Apply shadow effect when HasShadow is true -->
                        <DataTrigger Binding="{Binding HasShadow, Mode=OneWay}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <!-- Performance: RenderingBias=Performance for better frame rate -->
                                    <!-- Note: BlurRadius cannot be bound as DropShadowEffect is not a FrameworkElement -->
                                    <DropShadowEffect BlurRadius="10"
                                                    ShadowDepth="5"
                                                    Color="Black"
                                                    Opacity="0.5"
                                                    RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Text, Mode=OneWay}"
                      FontFamily="{Binding FontFamily, Mode=OneWay}"
                      FontSize="{Binding FontSize, Mode=OneWay}"
                      FontWeight="{Binding IsBold, Mode=OneWay, Converter={StaticResource BoolToFontWeight}}"
                      FontStyle="{Binding IsItalic, Mode=OneWay, Converter={StaticResource BoolToFontStyle}}"
                      Foreground="{Binding ForegroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                      TextAlignment="{Binding TextAlignment, Mode=OneWay}"
                      VerticalAlignment="{Binding VerticalAlignment, Mode=OneWay}"
                      TextWrapping="Wrap"
                      LineHeight="{Binding LineHeight, Mode=OneWay}"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="Auto"/>
        </Border>
    </DataTemplate>

    <!-- ImageElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:ImageElement}">
        <Border CornerRadius="{Binding CornerRadius, Mode=OneWay}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <!-- Show border when HasBorder is true -->
                        <DataTrigger Binding="{Binding HasBorder, Mode=OneWay}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding BorderColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, Mode=OneWay}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Best Practice: Use RenderOptions for image quality -->
            <!-- Performance: ImagePathConverter implements lazy loading with caching -->
            <!-- MultiBinding: ImageData takes priority over ImagePath for embedded images -->
            <Image Stretch="{Binding StretchMode, Converter={StaticResource ImageStretchConverter}}"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderOptions.EdgeMode="Unspecified">
                <Image.Source>
                    <MultiBinding Converter="{StaticResource ImagePathConverter}">
                        <Binding Path="ImagePath" Mode="OneWay"/>
                        <Binding Path="ImageData" Mode="OneWay"/>
                    </MultiBinding>
                </Image.Source>
            </Image>
        </Border>
    </DataTemplate>

    <!-- ShapeElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:ShapeElement}">
        <Grid>
            <!-- Rectangle -->
            <Rectangle Fill="{Binding FillColor, Converter={StaticResource ColorToBrushConverter}}"
                      Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                      StrokeThickness="{Binding StrokeThickness}"
                      RadiusX="{Binding CornerRadius}"
                      RadiusY="{Binding CornerRadius}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShapeType}" Value="Rectangle">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShapeType}" Value="RoundedRectangle">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- Ellipse -->
            <Ellipse Fill="{Binding FillColor, Converter={StaticResource ColorToBrushConverter}}"
                    Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                    StrokeThickness="{Binding StrokeThickness}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShapeType}" Value="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- Line -->
            <Line X1="0" Y1="0"
                  X2="{Binding Width}"
                  Y2="{Binding Height}"
                  Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                  StrokeThickness="{Binding StrokeThickness}">
                <Line.Style>
                    <Style TargetType="Line">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShapeType}" Value="Line">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Line.Style>
            </Line>
        </Grid>
    </DataTemplate>

    <!-- QrCodeElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:QrCodeElement}" xmlns:controls="clr-namespace:LayoutDesigner.Controls">
        <Border Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
                BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                BorderThickness="0"
                Padding="4">
            <!-- QR Code Control - renders actual QR code using QrCodeService -->
            <controls:QrCodeControl />
        </Border>
    </DataTemplate>

    <!-- DynamicFieldElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:DynamicFieldElement}">
        <Border Background="#FFF8F9FA"
                BorderBrush="#FFADB5BD"
                BorderThickness="1"
                Padding="8,4">
            <TextBlock Text="{Binding FieldType, StringFormat='[{0} Field]'}"
                      FontFamily="Consolas"
                      FontSize="14"
                      Foreground="#FF495057"
                      VerticalAlignment="Center"/>
        </Border>
    </DataTemplate>

    <!-- LineElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:LineElement}">
        <!-- Canvas container with transparent background for hit-testing -->
        <Canvas Background="Transparent">
            <!-- Invisible thicker line for easier clicking (10px thick transparent line) -->
            <Line X1="0" Y1="0"
                  X2="{Binding X2}"
                  Y2="{Binding Y2}"
                  Stroke="Transparent"
                  StrokeThickness="10"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- Actual visible line on top -->
            <Line X1="0" Y1="0"
                  X2="{Binding X2}"
                  Y2="{Binding Y2}"
                  Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                  StrokeThickness="{Binding StrokeThickness}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True"
                  IsHitTestVisible="False"/>
        </Canvas>
    </DataTemplate>

    <!-- ButtonElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:ButtonElement}">
        <Border Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
                BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                BorderThickness="{Binding BorderThickness}"
                CornerRadius="{Binding CornerRadius}"
                Padding="12,6">
            <TextBlock Text="{Binding Text}"
                      FontFamily="{Binding FontFamily}"
                      FontSize="{Binding FontSize}"
                      FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}"
                      FontStyle="{Binding IsItalic, Converter={StaticResource BoolToFontStyle}}"
                      Foreground="{Binding ForegroundColor, Converter={StaticResource ColorToBrushConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      TextOptions.TextFormattingMode="Display"/>
        </Border>
    </DataTemplate>

    <!-- TableElement DataTemplate -->
    <DataTemplate DataType="{x:Type models:TableElement}">
        <Border BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                BorderThickness="{Binding BorderThickness}"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowBorder}" Value="True">
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- 2D Grid of editable cells -->
            <ItemsControl ItemsSource="{Binding Cells}" x:Name="TableRows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Each row -->
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Each cell -->
                                    <Border x:Name="CellBorder"
                                            Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderThickness="{Binding BorderThickness}"
                                            MinWidth="80"
                                            MinHeight="30">
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                x:Name="CellTextBox"
                                                FontFamily="{Binding FontFamily}"
                                                FontSize="{Binding FontSize}"
                                                Foreground="{Binding ForegroundColor, Converter={StaticResource ColorToBrushConverter}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                IsReadOnly="{Binding IsReadOnly}"
                                                TextAlignment="{Binding HorizontalAlignment}"
                                                VerticalContentAlignment="{Binding VerticalAlignment}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsItalic}" Value="True">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <!-- ElementGroup DataTemplate -->
    <DataTemplate DataType="{x:Type models:ElementGroup}">
        <!-- Group is visualized with a dashed border and label to indicate grouped elements -->
        <Grid>
            <!-- Dashed border using Rectangle (Border doesn't support dash arrays) -->
            <Rectangle Stroke="#FF0078D7"
                      StrokeThickness="2"
                      RadiusX="4"
                      RadiusY="4"
                      Fill="Transparent"
                      StrokeDashArray="4 2">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Opacity" Value="0.7"/>
                        <Style.Triggers>
                            <!-- Highlight on mouse over for better visibility -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Setter Property="Stroke" Value="#FF005A9E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- Group indicator labels with padding -->
            <Grid Margin="4">
                <!-- Group name label -->
                <TextBlock Text="{Binding Name, StringFormat='Group: {0}', Mode=OneWay}"
                          FontFamily="Segoe UI"
                          FontSize="10"
                          FontWeight="Bold"
                          Foreground="#FF0078D7"
                          Background="#FFFFFF"
                          Padding="4,2"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="-2,-2,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="3"
                                        ShadowDepth="1"
                                        Color="Black"
                                        Opacity="0.3"
                                        RenderingBias="Performance"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Child count indicator -->
                <TextBlock Text="{Binding Children.Count, StringFormat='({0} items)', Mode=OneWay}"
                          FontFamily="Segoe UI"
                          FontSize="9"
                          Foreground="#FF666666"
                          Background="#FFFFFF"
                          Padding="4,1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="-2,14,0,0"/>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
