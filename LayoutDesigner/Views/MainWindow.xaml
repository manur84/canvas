<Window x:Class="LayoutDesigner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LayoutDesigner.Views"
        xmlns:vm="clr-namespace:LayoutDesigner.ViewModels"
        xmlns:controls="clr-namespace:LayoutDesigner.Controls"
        xmlns:models="clr-namespace:LayoutDesigner.Models"
        xmlns:converters="clr-namespace:LayoutDesigner.Converters"
        xmlns:behaviors="clr-namespace:LayoutDesigner.Behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CanvasViewModel.CopyCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CanvasViewModel.CutCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding CanvasViewModel.PasteCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignLeftCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignCenterCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignRightCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignTopCommand}"/>
        <KeyBinding Key="M" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignMiddleCommand}"/>
        <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.AlignBottomCommand}"/>
        <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.DistributeHorizontallyCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl+Shift" Command="{Binding CanvasViewModel.DistributeVerticallyCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomResetCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="Recent _Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xport">
                    <MenuItem Header="Export as _PNG..." Command="{Binding ExportPngCommand}"/>
                    <MenuItem Header="Export as _JPG..." Command="{Binding ExportJpgCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Copy" Command="{Binding CanvasViewModel.CopyCommand}" InputGestureText="Ctrl+C"/>
                <MenuItem Header="Cu_t" Command="{Binding CanvasViewModel.CutCommand}" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Paste" Command="{Binding CanvasViewModel.PasteCommand}" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="_Delete" Command="{Binding CanvasViewModel.DeleteSelectedCommand}" InputGestureText="Del"/>
                <MenuItem Header="Du_plicate" Command="{Binding CanvasViewModel.DuplicateSelectedCommand}" InputGestureText="Ctrl+D"/>
                <MenuItem Header="Select _All" Command="{Binding CanvasViewModel.SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="_Group" Command="{Binding CanvasViewModel.GroupCommand}" InputGestureText="Ctrl+G"/>
                <MenuItem Header="Un_group" Command="{Binding CanvasViewModel.UngroupCommand}" InputGestureText="Ctrl+Shift+G"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl+Plus"/>
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+Minus"/>
                <MenuItem Header="_Reset Zoom" Command="{Binding ZoomResetCommand}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="Show _Grid" IsCheckable="True" IsChecked="{Binding CanvasViewModel.ShowGrid}"/>
                <MenuItem Header="_Snap to Grid" IsCheckable="True" IsChecked="{Binding CanvasViewModel.SnapToGrid}"/>
            </MenuItem>

            <MenuItem Header="_Arrange">
                <MenuItem Header="Bring to _Front" Command="{Binding CanvasViewModel.BringToFrontCommand}" InputGestureText="Ctrl+]"/>
                <MenuItem Header="Send to _Back" Command="{Binding CanvasViewModel.SendToBackCommand}" InputGestureText="Ctrl+["/>
                <MenuItem Header="Bring _Forward" Command="{Binding CanvasViewModel.BringForwardCommand}" InputGestureText="Ctrl+Shift+]"/>
                <MenuItem Header="Send Back_ward" Command="{Binding CanvasViewModel.SendBackwardCommand}" InputGestureText="Ctrl+Shift+["/>
                <Separator/>
                <MenuItem Header="Align _Left" Command="{Binding CanvasViewModel.AlignLeftCommand}" InputGestureText="Ctrl+Shift+L"/>
                <MenuItem Header="Align _Center" Command="{Binding CanvasViewModel.AlignCenterCommand}" InputGestureText="Ctrl+Shift+C"/>
                <MenuItem Header="Align _Right" Command="{Binding CanvasViewModel.AlignRightCommand}" InputGestureText="Ctrl+Shift+R"/>
                <Separator/>
                <MenuItem Header="Align _Top" Command="{Binding CanvasViewModel.AlignTopCommand}" InputGestureText="Ctrl+Shift+T"/>
                <MenuItem Header="Align _Middle" Command="{Binding CanvasViewModel.AlignMiddleCommand}" InputGestureText="Ctrl+Shift+M"/>
                <MenuItem Header="Align _Bottom" Command="{Binding CanvasViewModel.AlignBottomCommand}" InputGestureText="Ctrl+Shift+B"/>
                <Separator/>
                <MenuItem Header="Distribute _Horizontally" Command="{Binding CanvasViewModel.DistributeHorizontallyCommand}" InputGestureText="Ctrl+Shift+H"/>
                <MenuItem Header="Distribute _Vertically" Command="{Binding CanvasViewModel.DistributeVerticallyCommand}" InputGestureText="Ctrl+Shift+V"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Height="40">
            <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="Copy" Command="{Binding CanvasViewModel.CopyCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Cut" Command="{Binding CanvasViewModel.CutCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Paste" Command="{Binding CanvasViewModel.PasteCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="Group" Command="{Binding CanvasViewModel.GroupCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Ungroup" Command="{Binding CanvasViewModel.UngroupCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="Zoom +" Command="{Binding ZoomInCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <Button Content="Zoom -" Command="{Binding ZoomOutCommand}" Style="{StaticResource IconButton}" Padding="8,4" Margin="2"/>
            <TextBlock Text="{Binding CanvasViewModel.Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="4,0"/>
        </ToolBar>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock Text="{Binding CanvasViewModel.Elements.Count, StringFormat=Elements: {0}}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CanvasViewModel.SelectedElements.Count, StringFormat=Selected: {0}}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Canvas: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CanvasViewModel.CanvasWidth, StringFormat={}{0:F0}}"/>
                    <Run Text=" × "/>
                    <Run Text="{Binding CanvasViewModel.CanvasHeight, StringFormat={}{0:F0}}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CanvasViewModel.Zoom, StringFormat=Zoom: {0:P0}}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Grid: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CanvasViewModel.ShowGrid, Converter={StaticResource BoolToYesNoConverter}}"/>
                    <Run Text=" | Snap: "/>
                    <Run Text="{Binding CanvasViewModel.SnapToGrid, Converter={StaticResource BoolToYesNoConverter}}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Position: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CanvasViewModel.SelectedElements[0].X, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                    <Run Text=", "/>
                    <Run Text="{Binding CanvasViewModel.SelectedElements[0].Y, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Size: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CanvasViewModel.SelectedElements[0].Width, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                    <Run Text=" × "/>
                    <Run Text="{Binding CanvasViewModel.SelectedElements[0].Height, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding UndoRedoStatus}" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel with Tabs -->
            <TabControl Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderThickness="0">
                <TabItem Header="Toolbox">
                    <local:ToolboxPanel DataContext="{Binding CanvasViewModel}"/>
                </TabItem>
                <TabItem Header="Templates">
                    <local:TemplateLibraryPanel x:Name="TemplateLibraryPanel" TemplateSelected="OnTemplateSelected"/>
                </TabItem>
            </TabControl>

            <!-- Canvas -->
            <Border Grid.Column="1" Background="{Binding CanvasViewModel.Document.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <controls:DesignCanvas x:Name="DesignCanvas"
                                          Width="{Binding CanvasViewModel.CanvasWidth}"
                                          Height="{Binding CanvasViewModel.CanvasHeight}"
                                          ShowGrid="{Binding CanvasViewModel.ShowGrid}"
                                          GridSize="{Binding CanvasViewModel.GridSize}"
                                          SnapToGrid="{Binding CanvasViewModel.SnapToGrid}"
                                          SnapToElements="True"
                                          Elements="{Binding CanvasViewModel.Elements}"
                                          CanvasViewModel="{Binding CanvasViewModel}">
                        <controls:DesignCanvas.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CanvasViewModel.Zoom}" ScaleY="{Binding CanvasViewModel.Zoom}"/>
                        </controls:DesignCanvas.LayoutTransform>

                        <controls:DesignCanvas.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Command="{Binding CanvasViewModel.CopyCommand}" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Cut" Command="{Binding CanvasViewModel.CutCommand}" InputGestureText="Ctrl+X"/>
                                <MenuItem Header="Paste" Command="{Binding CanvasViewModel.PasteCommand}" InputGestureText="Ctrl+V"/>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding CanvasViewModel.DeleteSelectedCommand}" InputGestureText="Del"/>
                                <MenuItem Header="Duplicate" Command="{Binding CanvasViewModel.DuplicateSelectedCommand}" InputGestureText="Ctrl+D"/>
                                <MenuItem Header="Select All" Command="{Binding CanvasViewModel.SelectAllCommand}" InputGestureText="Ctrl+A"/>
                                <Separator/>
                                <MenuItem Header="Arrange">
                                    <MenuItem Header="Bring to Front" Command="{Binding CanvasViewModel.BringToFrontCommand}"/>
                                    <MenuItem Header="Send to Back" Command="{Binding CanvasViewModel.SendToBackCommand}"/>
                                    <MenuItem Header="Bring Forward" Command="{Binding CanvasViewModel.BringForwardCommand}"/>
                                    <MenuItem Header="Send Backward" Command="{Binding CanvasViewModel.SendBackwardCommand}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Lock" Command="{Binding CanvasViewModel.LockCommand}"/>
                                <MenuItem Header="Unlock" Command="{Binding CanvasViewModel.UnlockCommand}"/>
                                <Separator/>
                                <MenuItem Header="Align">
                                    <MenuItem Header="Align Left" Command="{Binding CanvasViewModel.AlignLeftCommand}" InputGestureText="Ctrl+Shift+L"/>
                                    <MenuItem Header="Align Center" Command="{Binding CanvasViewModel.AlignCenterCommand}" InputGestureText="Ctrl+Shift+C"/>
                                    <MenuItem Header="Align Right" Command="{Binding CanvasViewModel.AlignRightCommand}" InputGestureText="Ctrl+Shift+R"/>
                                    <Separator/>
                                    <MenuItem Header="Align Top" Command="{Binding CanvasViewModel.AlignTopCommand}" InputGestureText="Ctrl+Shift+T"/>
                                    <MenuItem Header="Align Middle" Command="{Binding CanvasViewModel.AlignMiddleCommand}" InputGestureText="Ctrl+Shift+M"/>
                                    <MenuItem Header="Align Bottom" Command="{Binding CanvasViewModel.AlignBottomCommand}" InputGestureText="Ctrl+Shift+B"/>
                                    <Separator/>
                                    <MenuItem Header="Distribute Horizontally" Command="{Binding CanvasViewModel.DistributeHorizontallyCommand}" InputGestureText="Ctrl+Shift+H"/>
                                    <MenuItem Header="Distribute Vertically" Command="{Binding CanvasViewModel.DistributeVerticallyCommand}" InputGestureText="Ctrl+Shift+V"/>
                                </MenuItem>
                            </ContextMenu>
                        </controls:DesignCanvas.ContextMenu>

                        <!-- DataTemplates are now in Resources/ElementTemplates.xaml -->

                        <ItemsControl ItemsSource="{Binding CanvasViewModel.Elements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter" BasedOn="{StaticResource OptimizedCanvasElement}">
                                    <!-- Enable SelectionAdorner behavior -->
                                    <Setter Property="behaviors:SelectionBehavior.EnableSelectionAdorner" Value="True"/>

                                    <!-- Canvas positioning via attached properties -->
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                    <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>

                                    <!-- Rotation transform -->
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="{Binding Rotation}"/>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- Visibility and opacity -->
                                    <Setter Property="Opacity" Value="{Binding Opacity}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Locked element behavior -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </controls:DesignCanvas>
                </ScrollViewer>
            </Border>

            <!-- Property Panel -->
            <local:PropertyPanel Grid.Column="2" DataContext="{Binding PropertyPanelViewModel}"/>
        </Grid>
    </DockPanel>
</Window>
