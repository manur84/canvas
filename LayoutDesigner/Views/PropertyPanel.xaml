<UserControl x:Class="LayoutDesigner.Views.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:LayoutDesigner.Models"
             xmlns:controls="clr-namespace:LayoutDesigner.Controls"
             xmlns:behaviors="clr-namespace:LayoutDesigner.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="280"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Enum values provider for ImageStretchMode -->
        <ObjectDataProvider x:Key="ImageStretchModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ImageStretchMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Enum values provider for ShapeType -->
        <ObjectDataProvider x:Key="ShapeTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ShapeType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Enum values provider for DynamicFieldType -->
        <ObjectDataProvider x:Key="DynamicFieldTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DynamicFieldType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Text Element Properties Template -->
        <DataTemplate x:Key="TextElementPropertiesTemplate" DataType="{x:Type models:TextElement}">
            <GroupBox Header="Text Properties" Style="{StaticResource PropertyGroup}">
                <StackPanel>
                    <Label Content="Text:" Style="{StaticResource PropertyLabel}"/>
                    <TextBox Text="{Binding Text}"
                           TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="Font Family:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <ComboBox SelectedItem="{Binding FontFamily}" Style="{StaticResource ModernComboBox}">
                        <sys:String>Arial</sys:String>
                        <sys:String>Calibri</sys:String>
                        <sys:String>Times New Roman</sys:String>
                        <sys:String>Verdana</sys:String>
                        <sys:String>Segoe UI</sys:String>
                    </ComboBox>

                    <Label Content="Font Size:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding FontSize}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Bold" IsChecked="{Binding IsBold}" Style="{StaticResource ModernCheckBox}" Margin="0,0,8,0"/>
                        <CheckBox Content="Italic" IsChecked="{Binding IsItalic}" Style="{StaticResource ModernCheckBox}" Margin="0,0,8,0"/>
                        <CheckBox Content="Underline" IsChecked="{Binding IsUnderline}" Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>

                    <Label Content="Foreground Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding ForegroundColor}"/>

                    <Label Content="Background Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding BackgroundColor}" ShowTransparencyPattern="True"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <!-- Image Element Properties Template -->
        <DataTemplate x:Key="ImageElementPropertiesTemplate" DataType="{x:Type models:ImageElement}">
            <StackPanel>
                <GroupBox Header="Image Properties" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <Label Content="Image Path:" Style="{StaticResource PropertyLabel}"/>
                        <TextBox Text="{Binding ImagePath}"
                               Style="{StaticResource ModernTextBox}"/>
                        <Button Content="Browse..." Margin="0,4,0,0" Style="{StaticResource ModernButton}"
                                Command="{Binding DataContext.BrowseImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                        <Label Content="Stretch Mode:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource ImageStretchModeValues}}"
                                  SelectedItem="{Binding StretchMode}"
                                  Style="{StaticResource ModernComboBox}"/>

                        <CheckBox Content="Maintain Aspect Ratio" IsChecked="{Binding MaintainAspectRatio}"
                                Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Border Settings" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <CheckBox Content="Show Border" IsChecked="{Binding HasBorder}"
                                Style="{StaticResource ModernCheckBox}"/>

                        <Label Content="Border Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding BorderColor}"/>

                        <Label Content="Border Thickness:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding BorderThickness}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>

                        <Label Content="Corner Radius:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding CornerRadius}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <!-- Shape Element Properties Template -->
        <DataTemplate x:Key="ShapeElementPropertiesTemplate" DataType="{x:Type models:ShapeElement}">
            <GroupBox Header="Shape Properties" Style="{StaticResource PropertyGroup}">
                <StackPanel>
                    <Label Content="Shape Type:" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource ShapeTypeValues}}"
                              SelectedItem="{Binding ShapeType}"
                              Style="{StaticResource ModernComboBox}"/>

                    <Label Content="Fill Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding FillColor}" ShowTransparencyPattern="True"/>

                    <Label Content="Stroke Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding StrokeColor}"/>

                    <Label Content="Stroke Thickness:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding StrokeThickness}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="Corner Radius:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CornerRadius}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <!-- QR Code Element Properties Template -->
        <DataTemplate x:Key="QrCodeElementPropertiesTemplate" DataType="{x:Type models:QrCodeElement}">
            <GroupBox Header="QR Code Properties" Style="{StaticResource PropertyGroup}">
                <StackPanel>
                    <Label Content="Content:" Style="{StaticResource PropertyLabel}"/>
                    <TextBox Text="{Binding Content}"
                           TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="Foreground Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding ForegroundColor}"/>

                    <Label Content="Background Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding BackgroundColor}" ShowTransparencyPattern="True"/>

                    <Label Content="Error Correction Level:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <Slider Value="{Binding ErrorCorrectionLevel}" Minimum="0" Maximum="3"
                          TickFrequency="1" IsSnapToTickEnabled="True"
                          Style="{StaticResource ModernSlider}"/>
                    <TextBlock Text="{Binding ErrorCorrectionLevel}" Margin="0,2,0,0"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <!-- Dynamic Field Element Properties Template -->
        <DataTemplate x:Key="DynamicFieldElementPropertiesTemplate" DataType="{x:Type models:DynamicFieldElement}">
            <GroupBox Header="Dynamic Field Properties" Style="{StaticResource PropertyGroup}">
                <StackPanel>
                    <Label Content="Field Type:" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DynamicFieldTypeValues}}"
                              SelectedItem="{Binding FieldType}"
                              Style="{StaticResource ModernComboBox}"/>

                    <Label Content="Format:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Format}"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="Font Family:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <ComboBox SelectedItem="{Binding FontFamily}" Style="{StaticResource ModernComboBox}">
                        <sys:String>Arial</sys:String>
                        <sys:String>Calibri</sys:String>
                        <sys:String>Times New Roman</sys:String>
                        <sys:String>Verdana</sys:String>
                        <sys:String>Segoe UI</sys:String>
                    </ComboBox>

                    <Label Content="Font Size:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding FontSize}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <!-- Line Element Properties Template -->
        <DataTemplate x:Key="LineElementPropertiesTemplate" DataType="{x:Type models:LineElement}">
            <GroupBox Header="Line Properties" Style="{StaticResource PropertyGroup}">
                <StackPanel>
                    <Label Content="End X Position:" Style="{StaticResource PropertyLabel}"/>
                    <TextBox Text="{Binding X2}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="End Y Position:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Y2}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>

                    <Label Content="Stroke Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <controls:ColorInputControl ColorValue="{Binding StrokeColor}"/>

                    <Label Content="Stroke Thickness:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding StrokeThickness}"
                           behaviors:NumericInputBehavior.IsEnabled="True"
                           Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </GroupBox>
        </DataTemplate>

        <!-- Table Element Properties Template -->
        <DataTemplate x:Key="TableElementPropertiesTemplate" DataType="{x:Type models:TableElement}">
            <StackPanel>
                <GroupBox Header="Table Structure" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <Label Content="Rows:" Style="{StaticResource PropertyLabel}"/>
                        <TextBox Text="{Binding Rows}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>

                        <Label Content="Columns:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding Columns}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Header Settings" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <CheckBox Content="Show Header Row" IsChecked="{Binding ShowHeader}"
                                Style="{StaticResource ModernCheckBox}"/>

                        <Label Content="Header Background Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding HeaderBackgroundColor}"/>

                        <Label Content="Header Text Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding HeaderForegroundColor}"/>

                        <Label Content="Header Font Size:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding HeaderFontSize}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>

                        <CheckBox Content="Bold Header" IsChecked="{Binding HeaderBold}"
                                Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Row Colors" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <Label Content="Row Background Color:" Style="{StaticResource PropertyLabel}"/>
                        <controls:ColorInputControl ColorValue="{Binding RowBackgroundColor}" ShowTransparencyPattern="True"/>

                        <CheckBox Content="Alternate Row Colors" IsChecked="{Binding AlternateRows}"
                                Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/>

                        <Label Content="Alternate Row Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding AlternateRowBackgroundColor}" ShowTransparencyPattern="True"/>

                        <Label Content="Text Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding ForegroundColor}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Border Settings" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <CheckBox Content="Show Borders" IsChecked="{Binding ShowBorder}"
                                Style="{StaticResource ModernCheckBox}"/>

                        <Label Content="Border Color:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <controls:ColorInputControl ColorValue="{Binding BorderColor}"/>

                        <Label Content="Border Thickness:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding BorderThickness}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Font Settings" Style="{StaticResource PropertyGroup}">
                    <StackPanel>
                        <Label Content="Font Family:" Style="{StaticResource PropertyLabel}"/>
                        <ComboBox SelectedItem="{Binding FontFamily}" Style="{StaticResource ModernComboBox}">
                            <sys:String>Arial</sys:String>
                            <sys:String>Calibri</sys:String>
                            <sys:String>Times New Roman</sys:String>
                            <sys:String>Verdana</sys:String>
                            <sys:String>Segoe UI</sys:String>
                        </ComboBox>

                        <Label Content="Font Size:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding FontSize}"
                               behaviors:NumericInputBehavior.IsEnabled="True"
                               Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <!-- Template Selector -->
        <controls:ElementTypeTemplateSelector x:Key="ElementTypeTemplateSelector"
            TextElementTemplate="{StaticResource TextElementPropertiesTemplate}"
            ImageElementTemplate="{StaticResource ImageElementPropertiesTemplate}"
            ShapeElementTemplate="{StaticResource ShapeElementPropertiesTemplate}"
            QrCodeElementTemplate="{StaticResource QrCodeElementPropertiesTemplate}"
            DynamicFieldElementTemplate="{StaticResource DynamicFieldElementPropertiesTemplate}"
            LineElementTemplate="{StaticResource LineElementPropertiesTemplate}"
            TableElementTemplate="{StaticResource TableElementPropertiesTemplate}"/>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <!-- Canvas Properties (when no element selected) -->
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="Canvas Properties"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,0,12"/>

                    <GroupBox Header="Canvas Settings" Style="{StaticResource PropertyGroup}">
                        <StackPanel>
                            <Label Content="Canvas Width:" Style="{StaticResource PropertyLabel}"/>
                            <TextBox Text="{Binding CanvasWidth}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Canvas Height:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding CanvasHeight}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Grid Size:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding GridSize}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid}"
                                    Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/>
                            <CheckBox Content="Snap to Grid" IsChecked="{Binding SnapToGrid}"
                                    Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Canvas Appearance" Style="{StaticResource PropertyGroup}">
                        <StackPanel>
                            <Label Content="Background Color:" Style="{StaticResource PropertyLabel}"/>
                            <controls:ColorInputControl ColorValue="{Binding BackgroundColor}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- Multiple Selection Message -->
                <TextBlock Text="Multiple elements selected"
                          Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                          FontSize="14"
                          Foreground="{StaticResource SecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,20"/>

                <!-- Properties for Single Selection -->
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Common Properties -->
                    <GroupBox Header="General" Style="{StaticResource PropertyGroup}">
                        <StackPanel>
                            <Label Content="Name:" Style="{StaticResource PropertyLabel}"/>
                            <TextBox Text="{Binding SelectedElement.Name}"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Position X:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SelectedElement.X}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Position Y:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SelectedElement.Y}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Width:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SelectedElement.Width}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Height:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SelectedElement.Height}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}"/>

                            <Label Content="Rotation:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <Slider Value="{Binding SelectedElement.Rotation}" Minimum="0" Maximum="360"
                                  Style="{StaticResource ModernSlider}"/>
                            <TextBox Text="{Binding SelectedElement.Rotation, StringFormat={}{0:F1}°}"
                                   behaviors:NumericInputBehavior.IsEnabled="True"
                                   Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>

                            <Label Content="Opacity:" Style="{StaticResource PropertyLabel}" Margin="0,8,0,0"/>
                            <Slider Value="{Binding SelectedElement.Opacity}" Minimum="0" Maximum="1"
                                  Style="{StaticResource ModernSlider}"/>
                            <TextBox Text="{Binding SelectedElement.Opacity, StringFormat={}{0:P0}}"
                                   Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>

                            <CheckBox Content="Locked" IsChecked="{Binding SelectedElement.IsLocked}"
                                    Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/>
                            <CheckBox Content="Visible" IsChecked="{Binding SelectedElement.IsVisible}"
                                    Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Element-Specific Properties using ContentControl -->
                    <ContentControl Content="{Binding SelectedElement}"
                                  ContentTemplateSelector="{StaticResource ElementTypeTemplateSelector}"/>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
