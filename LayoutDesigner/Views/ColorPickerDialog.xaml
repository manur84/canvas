<Window x:Class="LayoutDesigner.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Color Picker"
        Height="480" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Color Preview -->
        <Border Grid.Row="0" Height="60" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- New Color -->
                <Border Grid.Column="0" Background="{Binding NewColorBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <TextBlock Text="New" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4" FontSize="10" Foreground="#80000000"/>
                </Border>

                <!-- Original Color -->
                <Border Grid.Column="1" Background="{Binding OriginalColorBrush}">
                    <TextBlock Text="Original" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4" FontSize="10" Foreground="#80000000"/>
                </Border>
            </Grid>
        </Border>

        <!-- Color Sliders -->
        <StackPanel Grid.Row="1">
            <!-- RGB Sliders -->
            <TextBlock Text="RGB" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFE74C3C"/>
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RedValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding RedValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF2ECC71"/>
                <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding GreenValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding GreenValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF3498DB"/>
                <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BlueValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding BlueValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <!-- Alpha Slider -->
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="A:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Slider x:Name="AlphaSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AlphaValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding AlphaValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <!-- HSV Sliders -->
            <TextBlock Text="HSV" FontWeight="Bold" Margin="0,16,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="H:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding HueValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding HueValue, StringFormat={}{0:F0}°, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="S:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SaturationValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding SaturationValue, StringFormat={}{0:F0}%, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="V:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Slider x:Name="ValueSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightnessValue}" Style="{StaticResource ModernSlider}" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding BrightnessValue, StringFormat={}{0:F0}%, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Hex Input -->
        <GroupBox Grid.Row="2" Header="Hex Color" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding HexColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="14"/>
                <TextBlock Grid.Column="1" Text="  e.g. #FFRRGGBB" VerticalAlignment="Center" Foreground="{StaticResource SecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="OK" Click="OnOkClick" Style="{StaticResource ModernButton}" Margin="0,0,4,0" Height="32"/>
            <Button Grid.Column="1" Content="Cancel" Click="OnCancelClick" Style="{StaticResource ModernButton}" Background="{StaticResource SecondaryBrush}" Margin="4,0,0,0" Height="32"/>
        </Grid>
    </Grid>
</Window>
